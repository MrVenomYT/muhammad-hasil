# EmailJS Configuration
# Replace these values with your actual keys from your EmailJS Dashboard (https://dashboard.emailjs.com/)
#
# Option A (Vercel Environment Variables - No Warning):
# EMAILJS_SERVICE_ID=your_service_id_here
# EMAILJS_TEMPLATE_ID=your_template_id_here
# EMAILJS_PUBLIC_KEY=your_public_key_here

# Option B (Vite Local .env):
EMAILJS_SERVICE_ID=your_service_id_here
EMAILJS_TEMPLATE_ID=your_template_id_here
EMAILJS_PUBLIC_KEY=your_public_key_here
